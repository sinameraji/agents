# agents@0.20.1 (Agents SDK) peer-depends on zod@^4 while this repo pins zod@^3.25 (which ships
# the zod/v4 compat subpath the SDK actually imports). Without this flag every fresh
# `npm install` / `npm ci` — including Workers Builds for the Deploy to Cloudflare button — fails
# with ERESOLVE. Remove when the repo moves to zod 4.
legacy-peer-deps=true
