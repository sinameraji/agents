# Copy to .dev.vars for local dev (never commit .dev.vars).
# The Deploy to Cloudflare button prompts for each uncommented name below.

# 32 random bytes, base64. Encrypts your stored model-provider keys at rest.  openssl rand -base64 32
ENCRYPTION_KEY=

# HMAC key that signs the login session cookie.  openssl rand -base64 32
AUTH_SECRET=

# The password you will log in with.
APP_PASSWORD=

# Your email address. Seeded as the instance owner (admin). Optional but recommended.
OWNER_EMAIL=

# Local dev only: bypass auth as this user when no real auth is configured. Never set in production.
# DEV_USER_EMAIL=you@example.com
